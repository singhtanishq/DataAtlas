# ============================================================
# DataAtlas environment configuration (example)
# Copy to `.env` and fill in real values. Never commit `.env`.
# ============================================================

APP_ENV=development

# Service ports
WEB_PORT=3000
CONTROL_PLANE_PORT=8080
INGESTION_PORT=8090

# Infrastructure (Docker Compose defaults)
POSTGRES_USER=dataatlas
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=dataatlas
DATABASE_URL=postgresql://dataatlas:dataatlas@localhost:5432/dataatlas
REDIS_URL=redis://localhost:6379/0
NATS_URL=nats://localhost:4222

# Object storage (MinIO)
OBJECT_STORAGE_ENDPOINT=http://localhost:9000
OBJECT_STORAGE_ACCESS_KEY=change-me-local-only
OBJECT_STORAGE_SECRET_KEY=change-me-local-only
OBJECT_STORAGE_BUCKET=dataatlas

# Secrets — generate random values for local development, e.g.:
#   openssl rand -hex 32
APP_ENCRYPTION_KEY=
SESSION_SECRET=

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Logging
LOG_LEVEL=debug
